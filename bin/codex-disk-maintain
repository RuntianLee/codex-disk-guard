#!/usr/bin/env bash
# codex-disk-maintain — truncate the WAL, prune expired log rows, and compact logs_2.sqlite.
# Touches logs_2.sqlite ONLY; never reads or writes sessions/ or memories/.
# If the database is busy/locked, it skips this run safely.
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
# Installed layout has lib next to bin; prefer the repo-relative path, fall back to the installed one.
if [ -f "$HERE/../lib/common.sh" ]; then source "$HERE/../lib/common.sh";
elif [ -f "$HERE/lib/common.sh" ]; then source "$HERE/lib/common.sh";
else echo "common.sh not found" >&2; exit 1; fi

db="$(cdt_logs_db)"
# Validate retention before arithmetic: with 'set -u' a non-numeric value would be
# treated as an unset variable name inside $(( )) and abort the whole run silently.
retention="$(cdt_validate_int CDT_RETENTION_DAYS 3)"
log() { printf '[maintain %s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }

[ -f "$db" ] || { log "no logs db at $db, nothing to do"; exit 0; }

# Short busy_timeout: if we hit a lock, give up this run without corrupting data.
# Stage 1: prune. Run separately from compaction so the log line can tell the
# truth — with one combined script, "skipped" could hide an already-committed DELETE.
cutoff="$(( $(date +%s) - retention*86400 ))"
out="$("$CDT_SQLITE" "$db" 2>&1 <<SQL
PRAGMA busy_timeout=2000;
DELETE FROM logs WHERE ts < $cutoff;
SQL
)"
if [ $? -ne 0 ]; then
  log "skipped (db busy/locked or error before any change): ${out}"
  exit 0   # safe skip, not treated as a failure
fi

# Stage 2: fold the WAL back and compact the file.
out="$("$CDT_SQLITE" "$db" 2>&1 <<SQL
PRAGMA busy_timeout=2000;
PRAGMA wal_checkpoint(TRUNCATE);
VACUUM;
SQL
)"
if [ $? -ne 0 ]; then
  log "pruned rows older than ${retention}d, but checkpoint/vacuum skipped (db busy/locked): ${out}"
  exit 0
fi
log "ok: pruned rows older than ${retention}d, checkpointed + vacuumed; size now $(cdt_human_bytes "$(cdt_file_size "$db")")"
exit 0
