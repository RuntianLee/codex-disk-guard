#!/usr/bin/env bash
# codex-disk-bench — staged A/B benchmark of Codex disk writing:
#   idle baseline / CLI active / desktop idle / desktop active.
# Each stage saves its result under $CDT_STATE_DIR/bench/, so the run can span
# sessions and the "install the desktop app" break point.
# Measurement reuses codex-disk-check's --measure (sudo fs_usage); 'report' only
# reads files and needs no sudo.
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
if [ -f "$HERE/../lib/common.sh" ]; then source "$HERE/../lib/common.sh";
elif [ -f "$HERE/lib/common.sh" ]; then source "$HERE/lib/common.sh";
else echo "common.sh not found" >&2; exit 1; fi

BENCH_DIR="$(cdt_state_dir)/bench"
mkdir -p "$BENCH_DIR"

# Locate the sibling maintain command (installed layout: same dir; repo layout: ../bin).
maintain_bin() {
  if [ -x "$HERE/codex-disk-maintain" ]; then echo "$HERE/codex-disk-maintain";
  elif [ -x "$HERE/../bin/codex-disk-maintain" ]; then echo "$HERE/../bin/codex-disk-maintain";
  else echo ""; fi
}

usage() {
  cat <<'EOF'
codex-disk-bench — four-state benchmark of Codex disk writing

Usage:
  codex-disk-bench guide                 # guided: runs (1)(2)(3), then prints next steps for the desktop app
  codex-disk-bench idle [secs=60]        # (1) idle baseline (no Codex running; do nothing)
  codex-disk-bench cli-active [secs=60]  # (2) CLI active (use the CLI normally during the window)
  codex-disk-bench maintain              # (3) run one maintenance pass to compact the shared log db
  codex-disk-bench desktop-idle [secs=120] # (4) desktop idle (after installing the app, do NOT touch it)
  codex-disk-bench desktop-active [secs=60]# (5) desktop active (use the app normally during the window)
  codex-disk-bench report                # print the comparison table (no sudo)
  codex-disk-bench reset                 # clear the saved results of this run

Note: measurement uses sudo fs_usage; each stage's result is saved under $CDT_STATE_DIR/bench/.
EOF
}

run_measure() { # <stage> <secs> <prompt>
  local stage="$1" secs="$2" prompt="$3"
  echo
  echo "=== stage ${stage}  (window ${secs}s) ==="
  echo "$prompt"
  printf 'Press Enter when ready to start (sudo is needed to run fs_usage)... '
  read -r _
  local residual; residual="$(cdt_detect_residual)"
  local json; json="$(cdt_measure "$secs" 1)"
  if [ -z "$json" ]; then
    echo "x measurement failed (sudo not granted?). Not saved." >&2
    return 1
  fi
  printf '%s\n' "$json" > "$BENCH_DIR/$stage.json"
  if [ -n "$residual" ]; then echo YES; else echo NO; fi > "$BENCH_DIR/$stage.residual"
  echo "Saved: $BENCH_DIR/$stage.json"
  printf '%s\n' "$json"
}

json_num() { # <file> <key>  extract a number (integer or decimal)
  sed -n "s/.*\"$2\":\\([0-9][0-9.]*\\).*/\\1/p" "$1"
}

report() {
  printf '\n%-16s %-8s %-10s %-14s %-9s\n' "stage" "win(s)" "written" "MB/day(eq)" "residual"
  printf -- '------------------------------------------------------------\n'
  local stage f ws wb mb res
  for stage in idle cli-active desktop-idle desktop-active; do
    f="$BENCH_DIR/$stage.json"
    if [ ! -f "$f" ]; then
      printf '%-16s %s\n' "$stage" "(not measured)"
      continue
    fi
    ws="$(json_num "$f" window_s)"
    wb="$(json_num "$f" write_bytes)"
    mb="$(json_num "$f" mb_per_day_active)"
    res="$(cat "$BENCH_DIR/$stage.residual" 2>/dev/null || echo '-')"
    printf '%-16s %-8s %-10s %-14s %-9s\n' \
      "$stage" "${ws:-?}" "$(cdt_human_bytes "${wb:-0}")" "${mb:-?}" "$res"
  done
  cat <<'EOF'

How to read it:
  - idle           should be ~0: an idle machine should barely write.
  - cli-active     writes while you actively use the CLI.
  - desktop-idle   writes while the desktop app runs and you do nothing; clearly > idle means the
                   "24/7 idle churn" from its background daemon (the real wear concern).
  - desktop-active writes while you actively use the desktop app.
  residual=YES means a resident background writer (e.g. the desktop daemon) was running during the sample.
EOF
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  idle)           run_measure idle "${1:-60}" "Make sure no Codex is running, and do nothing during the window." ;;
  cli-active)     run_measure cli-active "${1:-60}" "Use the Codex CLI normally for one typical task during the window." ;;
  desktop-idle)   run_measure desktop-idle "${1:-120}" "The desktop app is running; do NOT touch it (measures the daemon's idle writes)." ;;
  desktop-active) run_measure desktop-active "${1:-60}" "Use the desktop app normally for one typical task during the window." ;;
  maintain)
    m="$(maintain_bin)"
    if [ -n "$m" ]; then echo "=== stage maintain ==="; "$m"; else echo "codex-disk-maintain not found" >&2; exit 1; fi ;;
  report)         report ;;
  reset)          rm -f "$BENCH_DIR"/*.json "$BENCH_DIR"/*.residual 2>/dev/null; echo "Cleared $BENCH_DIR" ;;
  guide)
    echo "Running in order: (1) idle baseline -> (2) CLI active -> (3) maintenance. Stages (4)(5) need the desktop app installed."
    run_measure idle "${1:-60}" "Make sure no Codex is running, and do nothing during the window." || exit 1
    run_measure cli-active "60" "Use the Codex CLI normally for one typical task during the window." || exit 1
    m="$(maintain_bin)"; [ -n "$m" ] && { echo; echo "=== stage maintain ==="; "$m"; }
    cat <<'EOF'

(1)(2)(3) done. Next:
  1) Install and launch the Codex desktop app
  2) With the app running and untouched, run:  codex-disk-bench desktop-idle 120
  3) Use the app actively for a bit, then run:  codex-disk-bench desktop-active 60
  4) Print the comparison table:                codex-disk-bench report
EOF
    ;;
  help|--help|-h) usage ;;
  *) echo "unknown subcommand: $cmd" >&2; usage; exit 2 ;;
esac
